# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
POSTGRES_DB=restaurant_saas
POSTGRES_USER=restaurant_saas
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- JWT ---
JWT_SIGNING_KEY=replace-with-a-random-64-byte-base64-secret
JWT_ISSUER=RestaurantSaaS
JWT_AUDIENCE=RestaurantSaaS.Clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# --- Stripe (test mode keys only) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Email (SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace-me
SMTP_FROM_ADDRESS=no-reply@restaurantsaas.io

# --- SMS (Twilio) — Phase 2 ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Ports ---
API_HTTP_PORT=5000
WORKER_HANGFIRE_PORT=5001
WEB_PORT=4200

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
